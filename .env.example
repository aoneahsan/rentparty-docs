# Optional build settings for the Rent Party docs. Placeholders only: never commit a real value.
#
# The build reads these from its environment. In GitHub, set them as Actions secrets with these names;
# local builds leave them unset. An empty or malformed value keeps that provider off entirely.
#
# Leave both unset until the docs have an analytics opt-in like the game's own: the game's privacy page
# says analytics run only for players who agree to them.

# Google Analytics 4 measurement ID, shaped like G-XXXXXXXXXX
GA_MEASUREMENT_ID=

# Microsoft Clarity project ID
CLARITY_PROJECT_ID=
