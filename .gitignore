# Dependencies
/node_modules
/.pnp.*
/.yarn/*
!/.yarn/patches
!/.yarn/plugins

# Build output and caches
/build
/.docusaurus
/.cache-loader

# Environment: only .env.example is ever committed
.env
.env.*
!.env.example

# Other package managers' lockfiles: this repo uses yarn
package-lock.json
pnpm-lock.yaml

# Temporary browser profile from a local render check: never committed
/.tmp-profile

# Logs and OS files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db
